# Alpaca paper trading keys (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# true = paper (default), false = live money — change only when you understand the risk
ALPACA_PAPER=true

# Optional overrides
# LOOP_INTERVAL_SECONDS=45
# RISK_PROFILE=max
# MAX_DAILY_LOSS_PCT=8.0
# MAX_NEW_PER_CYCLE=5
# SPRINT_SIZE_MULT=1.35
# SURVIVAL_ENABLED=false
# POSITION_CUT_PCT=3.5
# BLOCK_REENTRY_AFTER_CUT=false

# Daily recap email (sent Mon–Fri ~4:05 PM ET after market close)
# RECAP_EMAIL_TO=you@example.com
# Option A — Resend (easiest): https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=Alpaca Bot <bot@yourdomain.com>
# Option B — any SMTP (Gmail app password, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# Option C — Discord/Slack webhook
# RECAP_WEBHOOK_URL=https://discord.com/api/webhooks/...
